{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "outer-marker-patrol",
  "title": "Outer Marker Patrol",
  "description": "An hour at endurance pace with a short lift every ten minutes to keep you honest.",
  "sport": "bike",
  "focus": "endurance",
  "difficulty": 2,
  "tags": [
    "aerobic",
    "long"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "intervals",
      "repeat": 4,
      "on": {
        "duration": 540,
        "power": 0.68,
        "label": "Patrol"
      },
      "off": {
        "duration": 60,
        "power": 0.85,
        "label": "Marker check"
      }
    },
    {
      "kind": "steady",
      "duration": 300,
      "power": 0.65,
      "label": "Return leg"
    },
    {
      "kind": "ramp",
      "duration": 300,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
