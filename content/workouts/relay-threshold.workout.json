{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "relay-threshold",
  "title": "Relay Threshold",
  "description": "Three eight-minute blocks at threshold pace, two minutes of jogging between them. Hard but even: the last block should feel like the first one did.",
  "sport": "run",
  "focus": "threshold",
  "difficulty": 4,
  "tags": [
    "threshold"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.62,
      "to": 0.82,
      "label": "Warm up",
      "intensity": "warmup"
    },
    {
      "kind": "steady",
      "duration": 60,
      "pace": 0.95,
      "label": "Pick up"
    },
    {
      "kind": "steady",
      "duration": 120,
      "pace": 0.72,
      "label": "Settle"
    },
    {
      "kind": "intervals",
      "repeat": 3,
      "on": {
        "duration": 480,
        "pace": 1.0,
        "label": "Relay block"
      },
      "off": {
        "duration": 120,
        "pace": 0.72,
        "label": "Jog"
      },
      "texts": [
        {
          "offset": 5,
          "message": "Threshold. Even pace, not heroic."
        },
        {
          "offset": 1205,
          "message": "Last block. Hold the line."
        }
      ]
    },
    {
      "kind": "ramp",
      "duration": 480,
      "from": 0.75,
      "to": 0.55,
      "label": "Cool down",
      "intensity": "cooldown"
    }
  ]
}
