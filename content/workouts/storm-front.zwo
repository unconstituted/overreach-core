<workout_file>
  <author>Rubicon concept</author>
  <name>Rubicon: Storm Front</name>
  <description>Chapter test mission on the storm world. 60 min mixed endurance with irregular swells, a squall line of short gusts, a calm eye and two over-under passes beside a giant waterspout. Tip: if your trainer struggles with the squall gusts in ERG, switch ERG off for 24:00-32:30.</description>
  <sportType>bike</sportType>
  <tags><tag name="Rubicon"/></tags>
  <workout>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="10" message="AI: Dropping through the cloud deck. Easy for now."/>
      <textevent timeoffset="120" message="AI: Sea state is climbing. Stay low and let the swell carry us."/>
    </SteadyState>
    <SteadyState Duration="40" Power="0.74">
    </SteadyState>
    <SteadyState Duration="170" Power="0.60">
    </SteadyState>
    <SteadyState Duration="50" Power="0.78">
    </SteadyState>
    <SteadyState Duration="100" Power="0.65">
      <textevent timeoffset="90" message="AI: Swell ahead. Ride up and over."/>
    </SteadyState>
    <SteadyState Duration="90" Power="0.84">
    </SteadyState>
    <SteadyState Duration="60" Power="0.66">
    </SteadyState>
    <SteadyState Duration="45" Power="0.90">
    </SteadyState>
    <SteadyState Duration="90" Power="0.64">
    </SteadyState>
    <SteadyState Duration="120" Power="0.82">
    </SteadyState>
    <SteadyState Duration="45" Power="0.62">
    </SteadyState>
    <SteadyState Duration="60" Power="0.93">
      <textevent timeoffset="10" message="AI: Big one. Hold it."/>
    </SteadyState>
    <SteadyState Duration="30" Power="0.70">
    </SteadyState>
    <SteadyState Duration="60" Power="0.86">
    </SteadyState>
    <SteadyState Duration="120" Power="0.63">
    </SteadyState>
    <SteadyState Duration="90" Power="0.58">
      <textevent timeoffset="10" message="AI: Lull. The waves are coming in the same order..."/>
    </SteadyState>
    <SteadyState Duration="20" Power="0.80">
    </SteadyState>
    <SteadyState Duration="70" Power="0.58">
      <textevent timeoffset="60" message="AI: Squall line! Spin the turbines up NOW."/>
    </SteadyState>
    <SteadyState Duration="15" Power="1.40" Cadence="100">
    </SteadyState>
    <SteadyState Duration="45" Power="0.62">
    </SteadyState>
    <SteadyState Duration="30" Power="1.25" Cadence="100">
    </SteadyState>
    <SteadyState Duration="15" Power="0.65">
      <textevent timeoffset="10" message="AI: Gust incoming. Spin up!"/>
    </SteadyState>
    <SteadyState Duration="10" Power="1.50" Cadence="100">
    </SteadyState>
    <SteadyState Duration="65" Power="0.60">
    </SteadyState>
    <SteadyState Duration="25" Power="1.32" Cadence="100">
    </SteadyState>
    <SteadyState Duration="15" Power="0.70">
    </SteadyState>
    <SteadyState Duration="15" Power="1.38" Cadence="100">
    </SteadyState>
    <SteadyState Duration="65" Power="0.60">
    </SteadyState>
    <SteadyState Duration="35" Power="1.18" Cadence="100">
    </SteadyState>
    <SteadyState Duration="25" Power="0.64">
      <textevent timeoffset="20" message="AI: Spin up! Big gust."/>
    </SteadyState>
    <SteadyState Duration="12" Power="1.50" Cadence="100">
    </SteadyState>
    <SteadyState Duration="18" Power="0.75">
    </SteadyState>
    <SteadyState Duration="20" Power="1.35" Cadence="100">
    </SteadyState>
    <SteadyState Duration="100" Power="0.58">
    </SteadyState>
    <SteadyState Duration="210" Power="0.52">
      <textevent timeoffset="10" message="AI: ...We're in the eye. Dead calm. Listen."/>
      <textevent timeoffset="130" message="AI: Something is broadcasting from the waterspout."/>
      <textevent timeoffset="200" message="AI: Spout ahead. Hold the line while I record."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.92">
    </SteadyState>
    <SteadyState Duration="40" Power="1.06">
    </SteadyState>
    <SteadyState Duration="80" Power="0.90">
    </SteadyState>
    <SteadyState Duration="30" Power="1.12">
    </SteadyState>
    <SteadyState Duration="60" Power="0.93">
    </SteadyState>
    <SteadyState Duration="60" Power="1.04">
    </SteadyState>
    <SteadyState Duration="150" Power="0.55">
      <textevent timeoffset="10" message="AI: Playback. There's a pattern. Like a sentence."/>
      <textevent timeoffset="140" message="AI: Second pass. Closer this time."/>
    </SteadyState>
    <SteadyState Duration="60" Power="0.94">
    </SteadyState>
    <SteadyState Duration="45" Power="1.08">
    </SteadyState>
    <SteadyState Duration="60" Power="0.91">
    </SteadyState>
    <SteadyState Duration="25" Power="1.20" Cadence="100">
    </SteadyState>
    <SteadyState Duration="70" Power="0.95">
    </SteadyState>
    <SteadyState Duration="60" Power="1.10">
      <textevent timeoffset="55" message="AI: It's reaching for us. EVERYTHING you've got!"/>
    </SteadyState>
    <SteadyState Duration="40" Power="1.25" Cadence="100">
    </SteadyState>
    <SteadyState Duration="180" Power="0.62">
      <textevent timeoffset="10" message="AI: Out of the storm. Turning for home."/>
      <textevent timeoffset="175" message="AI: Rogue wave! Spin up!"/>
    </SteadyState>
    <SteadyState Duration="30" Power="0.85">
    </SteadyState>
    <Cooldown Duration="390" PowerLow="0.58" PowerHigh="0.45">
      <textevent timeoffset="90" message="AI: The storm answered us. I don't know what we said."/>
    </Cooldown>
  </workout>
</workout_file>
