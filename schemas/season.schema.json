{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overreach.game/schemas/season.schema.json",
  "title": "Overreach season",
  "description": "An ordered list of chapters and the story flags carried between them.",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "description",
    "chapters"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unlock": {
      "$ref": "#/$defs/unlock"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "unlock": {
            "$ref": "#/$defs/unlock"
          }
        }
      }
    }
  },
  "$defs": {
    "unlock": {
      "description": "When this becomes available. See docs/AUTHORING.md.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "always"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "chapterCompleted"
            },
            "chapter": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "required": [
            "type",
            "chapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "flag"
            },
            "season": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "flag": {
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "season",
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "totalDistance"
            },
            "km": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "km"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "totalTime"
            },
            "hours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "hours"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "planWeek"
            },
            "week": {
              "type": "integer",
              "minimum": 1
            },
            "plan": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "required": [
            "type",
            "week"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "all",
                "any"
              ]
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/unlock"
              }
            }
          },
          "required": [
            "type",
            "rules"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
