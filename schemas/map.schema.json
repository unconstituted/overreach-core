{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overreach.game/schemas/map.schema.json",
  "title": "Overreach map",
  "description": "A route for free riding: a scene kit plus a terrain profile.",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "description",
    "use",
    "length",
    "profile",
    "scene"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "freeRide",
          "chapter"
        ]
      }
    },
    "length": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Metres of road."
    },
    "profile": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "description": "[distance m, grade %] keys."
    },
    "image": {
      "type": "string"
    },
    "unlock": {
      "$ref": "#/$defs/unlock"
    },
    "scene": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "speedScale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "camera": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "streaks": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "fov": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "$defs": {
    "unlock": {
      "description": "When this becomes available. See docs/AUTHORING.md.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "always"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "chapterCompleted"
            },
            "chapter": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "required": [
            "type",
            "chapter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "flag"
            },
            "season": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "flag": {
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "season",
            "flag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "totalDistance"
            },
            "km": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "km"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "totalTime"
            },
            "hours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "hours"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "planWeek"
            },
            "week": {
              "type": "integer",
              "minimum": 1
            },
            "plan": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "required": [
            "type",
            "week"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "all",
                "any"
              ]
            },
            "rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/unlock"
              }
            }
          },
          "required": [
            "type",
            "rules"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
