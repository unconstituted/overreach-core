{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "hold-the-line",
  "title": "Hold the Line",
  "description": "Three ten-minute efforts at threshold. The number does not move. Neither do you.",
  "sport": "bike",
  "focus": "threshold",
  "difficulty": 4,
  "tags": [
    "threshold"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "steady",
      "duration": 60,
      "power": 1.0,
      "label": "Primer"
    },
    {
      "kind": "steady",
      "duration": 180,
      "power": 0.5,
      "label": "Reset"
    },
    {
      "kind": "intervals",
      "repeat": 3,
      "on": {
        "duration": 600,
        "power": 0.98,
        "label": "Hold the line"
      },
      "off": {
        "duration": 300,
        "power": 0.5,
        "label": "Breathe"
      }
    },
    {
      "kind": "ramp",
      "duration": 300,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
