{
  "name": "overreach-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Overreach ride engine: devices, workout engine, chapter runtime, HUD and feel layer.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p src/core && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate": "tsx tools/validate-chapters.ts",
    "ride-script": "tsx tools/ride-script-to-chapter.ts",
    "check:ride": "npm run build && node tools/ride-check.mjs",
    "catalogue": "tsx tools/build-catalogue.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "fit-file-parser": "^6.2.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "^0.187.0"
  }
}
