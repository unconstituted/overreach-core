{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "ring-runs",
  "title": "Ring Runs",
  "description": "Thirty seconds on, thirty off, in two sets of eight. Fast legs through the rings; the rest is barely a rest.",
  "sport": "bike",
  "focus": "vo2",
  "difficulty": 4,
  "tags": [
    "vo2 max",
    "short intervals"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "intervals",
      "repeat": 8,
      "on": {
        "duration": 30,
        "power": 1.25,
        "label": "Ring",
        "cadence": 100
      },
      "off": {
        "duration": 30,
        "power": 0.5,
        "label": "Gap"
      },
      "erg": false
    },
    {
      "kind": "steady",
      "duration": 300,
      "power": 0.5,
      "label": "Regroup"
    },
    {
      "kind": "intervals",
      "repeat": 8,
      "on": {
        "duration": 30,
        "power": 1.25,
        "label": "Ring",
        "cadence": 100
      },
      "off": {
        "duration": 30,
        "power": 0.5,
        "label": "Gap"
      },
      "erg": false
    },
    {
      "kind": "ramp",
      "duration": 420,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
