{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "convoy-pace",
  "title": "Convoy Pace",
  "description": "Three ten-minute tempo blocks. Hard enough to need attention, easy enough to hold a conversation with Control.",
  "sport": "bike",
  "focus": "tempo",
  "difficulty": 3,
  "tags": [
    "tempo"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "intervals",
      "repeat": 3,
      "on": {
        "duration": 600,
        "power": 0.83,
        "label": "Convoy",
        "cadence": 90
      },
      "off": {
        "duration": 180,
        "power": 0.55,
        "label": "Fall back"
      }
    },
    {
      "kind": "ramp",
      "duration": 300,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
