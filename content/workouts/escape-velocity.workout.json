{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "escape-velocity",
  "title": "Escape Velocity",
  "description": "Eight forty-five-second efforts well over threshold with long recoveries. Every one should feel like leaving something behind.",
  "sport": "bike",
  "focus": "anaerobic",
  "difficulty": 5,
  "tags": [
    "anaerobic"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "steady",
      "duration": 20,
      "power": 1.2,
      "label": "Test burn"
    },
    {
      "kind": "steady",
      "duration": 160,
      "power": 0.5,
      "label": "Reset"
    },
    {
      "kind": "intervals",
      "repeat": 8,
      "on": {
        "duration": 45,
        "power": 1.35,
        "label": "Escape burn"
      },
      "off": {
        "duration": 135,
        "power": 0.5,
        "label": "Recover"
      },
      "erg": false
    },
    {
      "kind": "ramp",
      "duration": 480,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
