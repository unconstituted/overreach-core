{
  "$schema": "../../schemas/workout.schema.json",
  "format": 1,
  "id": "burn-windows",
  "title": "Burn Windows",
  "description": "Five three-minute burns at VO2 max. Each window is short. Use all of it.",
  "sport": "bike",
  "focus": "vo2",
  "difficulty": 4,
  "tags": [
    "vo2 max"
  ],
  "steps": [
    {
      "kind": "ramp",
      "duration": 600,
      "from": 0.45,
      "to": 0.75,
      "label": "Systems warm",
      "intensity": "warmup"
    },
    {
      "kind": "steady",
      "duration": 30,
      "power": 1.1,
      "label": "Opener"
    },
    {
      "kind": "steady",
      "duration": 150,
      "power": 0.5,
      "label": "Reset"
    },
    {
      "kind": "intervals",
      "repeat": 5,
      "on": {
        "duration": 180,
        "power": 1.15,
        "label": "Burn window",
        "cadence": 95
      },
      "off": {
        "duration": 180,
        "power": 0.5,
        "label": "Coast"
      },
      "erg": false
    },
    {
      "kind": "ramp",
      "duration": 420,
      "from": 0.6,
      "to": 0.4,
      "label": "Power down",
      "intensity": "cooldown"
    }
  ]
}
